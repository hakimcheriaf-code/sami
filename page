<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
<meta name="theme-color" content="#1e3a8a">
<meta name="description" content="بوابة الدفع الإلكتروني الآمنة - بريد الجزائر">
<title>الدفع الآمن | بريد الجزائر</title>
<style>
  *, *::before, *::after {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    -webkit-tap-highlight-color: transparent;
  }

  :root {
    --primary: #1e3a8a;
    --primary-light: #3b82f6;
    --primary-lighter: #eff6ff;
    --primary-border: #dbeafe;
    --danger: #ef4444;
    --success: #10b981;
    --success-dark: #059669;
    --text-dark: #1f2937;
    --text-medium: #4b5563;
    --text-light: #9ca3af;
    --border: #e5e7eb;
    --white: #ffffff;
    --shadow-md: 0 4px 12px rgba(0,0,0,0.1);
    --shadow-lg: 0 20px 50px rgba(0,0,0,0.3);
    --shadow-primary: 0 10px 25px rgba(30,58,138,0.4);
    --radius-sm: 10px;
    --radius-md: 12px;
    --radius-lg: 20px;
    --transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Tahoma, Arial, sans-serif;
    background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    color: var(--text-dark);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }

  .open-btn {
    padding: 16px 42px;
    font-size: 17px;
    font-weight: 700;
    color: var(--primary);
    background: var(--white);
    border: none;
    border-radius: 50px;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: var(--transition);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: inherit;
  }

  .open-btn:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 30px rgba(0,0,0,0.25);
  }

  .open-btn:active { transform: translateY(-1px); }

  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.75);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 1000;
    justify-content: center;
    align-items: center;
    padding: 20px;
    overflow-y: auto;
    animation: fadeIn 0.3s ease;
  }

  .modal-overlay.active { display: flex; }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes slideUp {
    from { transform: translateY(30px) scale(0.98); opacity: 0; }
    to { transform: translateY(0) scale(1); opacity: 1; }
  }
  @keyframes pop {
    0% { transform: scale(0); }
    50% { transform: scale(1.2); }
    100% { transform: scale(1); }
  }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-6px); }
    75% { transform: translateX(6px); }
  }
  @keyframes successPop {
    0% { transform: scale(0) rotate(-180deg); opacity: 0; }
    60% { transform: scale(1.15) rotate(10deg); opacity: 1; }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }
  @keyframes checkDraw {
    0% { stroke-dashoffset: 100; }
    100% { stroke-dashoffset: 0; }
  }
  @keyframes ripple {
    0% { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(2.2); opacity: 0; }
  }
  @keyframes slideInDown {
    from { transform: translateY(-20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
  }
  @keyframes bounceIn {
    0% { transform: scale(0.3); opacity: 0; }
    50% { transform: scale(1.05); opacity: 1; }
    70% { transform: scale(0.95); }
    100% { transform: scale(1); }
  }

  .modal-box {
    background: var(--white);
    width: 100%;
    max-width: 480px;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    max-height: calc(100vh - 40px);
    max-height: calc(100dvh - 40px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .modal-header-bar {
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    color: var(--white);
    padding: 22px 25px;
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    flex-shrink: 0;
  }

  .logo-poste {
    width: 50px;
    height: 50px;
    background: var(--white);
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--primary);
    font-size: 24px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    flex-shrink: 0;
  }

  .header-text { flex: 1; min-width: 0; }
  .header-text h2 { font-size: 17px; font-weight: 700; margin-bottom: 3px; }
  .header-text p { font-size: 11.5px; opacity: 0.9; font-weight: 400; }

  .close-btn {
    position: absolute;
    top: 18px;
    left: 18px;
    background: rgba(255,255,255,0.15);
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    color: var(--white);
    display: flex;
    justify-content: center;
    align-items: center;
    transition: var(--transition);
    flex-shrink: 0;
  }

  .close-btn:hover {
    background: rgba(255,255,255,0.3);
    transform: rotate(90deg);
  }

  .modal-body {
    padding: 24px;
    overflow-y: auto;
    flex: 1;
    scrollbar-width: thin;
    scrollbar-color: var(--border) transparent;
  }

  .modal-body::-webkit-scrollbar { width: 6px; }
  .modal-body::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 3px;
  }

  .payment-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-bottom: 22px;
  }

  .method-tab {
    padding: 14px 10px;
    border: 2px solid var(--border);
    border-radius: var(--radius-md);
    background: var(--white);
    cursor: pointer;
    text-align: center;
    transition: var(--transition);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-medium);
    font-family: inherit;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
  }

  .method-tab .icon { font-size: 22px; line-height: 1; }
  .method-tab:hover { border-color: var(--primary-light); transform: translateY(-1px); }

  .method-tab.active {
    border-color: var(--primary);
    background: var(--primary-lighter);
    color: var(--primary);
    box-shadow: 0 4px 12px rgba(30,58,138,0.15);
  }

  .form-group { margin-bottom: 16px; }

  .form-group label {
    display: block;
    margin-bottom: 7px;
    color: var(--text-medium);
    font-size: 13px;
    font-weight: 600;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 13px 15px;
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 15px;
    transition: var(--transition);
    outline: none;
    background: var(--white);
    font-family: inherit;
    color: var(--text-dark);
  }

  .form-group input::placeholder { color: var(--text-light); }

  .form-group input:focus,
  .form-group select:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 4px rgba(30,58,138,0.1);
  }

  .form-group input.error {
    border-color: var(--danger);
    animation: shake 0.3s ease;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .phone-input-group {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }

  .phone-prefix {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0 14px;
    background: var(--primary-lighter);
    border: 2px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 14px;
    font-weight: 700;
    color: var(--primary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .phone-input-group input { flex: 1; min-width: 0; }

  .pay-btn {
    width: 100%;
    padding: 15px;
    font-size: 16px;
    font-weight: 700;
    color: var(--white);
    background: linear-gradient(135deg, var(--primary), var(--primary-light));
    border: none;
    border-radius: var(--radius-md);
    cursor: pointer;
    margin-top: 10px;
    transition: var(--transition);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    font-family: inherit;
    position: relative;
    overflow: hidden;
  }

  .pay-btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary-light), var(--primary));
    opacity: 0;
    transition: opacity 0.3s;
  }

  .pay-btn > * { position: relative; z-index: 1; }

  .pay-btn:hover:not(:disabled)::before { opacity: 1; }
  .pay-btn:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-primary);
  }

  .pay-btn:disabled { opacity: 0.7; cursor: not-allowed; }

  .spinner {
    width: 18px;
    height: 18px;
    border: 2.5px solid rgba(255,255,255,0.3);
    border-top-color: var(--white);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  .secure-note {
    text-align: center;
    font-size: 12px;
    color: var(--text-light);
    margin-top: 16px;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }

  .modal-footer {
    padding: 12px 25px 20px;
    text-align: center;
    font-size: 11px;
    color: var(--text-light);
    border-top: 1px solid var(--border);
    flex-shrink: 0;
  }

  .modal-footer strong { color: var(--primary); }

  .success-screen {
    display: none;
    text-align: center;
    padding: 40px 25px 35px;
  }

  .success-screen.active {
    display: block;
    animation: fadeIn 0.4s ease;
  }

  .success-icon-wrapper {
    position: relative;
    width: 120px;
    height: 120px;
    margin: 0 auto 25px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ripple-circle {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--success);
    opacity: 0;
    animation: ripple 1.8s ease-out infinite;
  }

  .ripple-circle:nth-child(2) { animation-delay: 0.6s; }

  .success-icon {
    position: relative;
    z-index: 2;
    width: 100px;
    height: 100px;
    background: linear-gradient(135deg, var(--success), var(--success-dark));
    border-radius: 50%;
    display: flex;
    justify-content: center;
    align-items: center;
    animation: successPop 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
    box-shadow: 0 15px 40px rgba(16, 185, 129, 0.4);
  }

  .check-svg { width: 55px; height: 55px; }

  .check-svg path {
    stroke: var(--white);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-linejoin: round;
    fill: none;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    animation: checkDraw 0.6s ease-out 0.4s forwards;
  }

  .success-screen h2 {
    color: var(--success-dark);
    margin-bottom: 12px;
    font-size: 24px;
    font-weight: 700;
    animation: slideInDown 0.5s ease 0.5s both;
  }

  .success-subtitle {
    color: var(--text-medium);
    margin-bottom: 8px;
    font-size: 14px;
    animation: slideInDown 0.5s ease 0.6s both;
  }

  .sent-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, #d1fae5, #a7f3d0);
    color: var(--success-dark);
    padding: 8px 18px;
    border-radius: 50px;
    font-size: 13px;
    font-weight: 700;
    margin: 15px 0;
    animation: bounceIn 0.6s ease 0.7s both;
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.2);
  }

  .sent-badge .badge-icon {
    font-size: 16px;
    animation: pop 0.5s ease 1.2s both;
  }

  .receipt-info {
    background: var(--primary-lighter);
    border-radius: var(--radius-sm);
    padding: 16px;
    margin: 22px 0;
    font-size: 13px;
    color: var(--text-medium);
    text-align: right;
    line-height: 2;
    border: 1px solid var(--primary-border);
    animation: slideInDown 0.5s ease 0.8s both;
  }

  .receipt-info strong {
    color: var(--primary);
    direction: ltr;
    display: inline-block;
  }

  .done-btn {
    padding: 13px 50px;
    background: linear-gradient(135deg, var(--success), var(--success-dark));
    color: var(--white);
    border: none;
    border-radius: 50px;
    font-size: 15px;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    font-family: inherit;
    animation: bounceIn 0.6s ease 1s both;
  }

  .done-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.4);
  }

  .hidden { display: none !important; }

  @media (max-width: 480px) {
    body { padding: 12px; }
    .modal-overlay { padding: 12px; }
    .modal-box {
      max-height: calc(100dvh - 24px);
      border-radius: 16px;
    }
    .modal-header-bar { padding: 18px 20px; }
    .logo-poste { width: 42px; height: 42px; font-size: 20px; }
    .header-text h2 { font-size: 15px; }
    .header-text p { font-size: 10.5px; }
    .modal-body { padding: 20px; }
    .method-tab { font-size: 11.5px; padding: 12px 6px; }
    .form-row { gap: 8px; }
    .phone-prefix { padding: 0 10px; font-size: 13px; }
    .success-icon-wrapper { width: 100px; height: 100px; }
    .success-icon { width: 85px; height: 85px; }
    .check-svg { width: 45px; height: 45px; }
    .success-screen h2 { font-size: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
</head>
<body>

  <button class="open-btn" onclick="openModal()" aria-label="فتح بوابة الدفع">
    <span>📮</span>
    <span>الدفع عبر بريد الجزائر</span>
  </button>

  <div class="modal-overlay" id="paymentModal" role="dialog" aria-modal="true">
    <div class="modal-box">

      <div class="modal-header-bar">
        <div class="logo-poste">📮</div>
        <div class="header-text">
          <h2>بريد الجزائر</h2>
          <p>Algérie Poste — بوابة الدفع الآمن</p>
        </div>
        <button class="close-btn" onclick="closeModal()" aria-label="إغلاق">✕</button>
      </div>

      <div id="paymentForm">
        <div class="modal-body">

          <div class="payment-methods">
            <button type="button" class="method-tab active" data-method="edahabia"
                    onclick="selectMethod(this)">
              <span class="icon">💳</span>
              <span>بطاقة الذهبية</span>
            </button>
            <button type="button" class="method-tab" data-method="ccp"
                    onclick="selectMethod(this)">
              <span class="icon">🏦</span>
              <span>CCP</span>
            </button>
          </div>

          <form onsubmit="processPayment(event)" id="payForm" novalidate>

            <div id="edahabiaFields">
              <div class="form-group">
                <label for="cardName">الاسم على البطاقة</label>
                <input type="text" id="cardName" placeholder="BENALI AHMED"
                       autocomplete="cc-name" required>
              </div>

              <div class="form-group">
                <label for="cardNumber">رقم بطاقة الذهبية</label>
                <input type="text" id="cardNumber" placeholder="0000 0000 0000 0000"
                       maxlength="19" inputmode="numeric" autocomplete="cc-number"
                       oninput="formatCard(this)" required>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="expiry">تاريخ الانتهاء</label>
                  <input type="text" id="expiry" placeholder="MM/YY" maxlength="5"
                         inputmode="numeric" autocomplete="cc-exp"
                         oninput="formatDate(this)" required>
                </div>
                <div class="form-group">
                  <label for="cvv">رمز CVV</label>
                  <input type="text" id="cvv" placeholder="123" maxlength="3"
                         inputmode="numeric" autocomplete="cc-csc"
                         oninput="onlyNumbers(this)" required>
                </div>
              </div>

              <div class="form-group">
                <label for="phone1">رقم الهاتف</label>
                <div class="phone-input-group">
                  <div class="phone-prefix">🇩🇿 +213</div>
                  <input type="tel" id="phone1" placeholder="5XX XX XX XX"
                         maxlength="13" inputmode="numeric"
                         oninput="formatPhone(this)" required>
                </div>
              </div>
            </div>

            <div id="ccpFields" class="hidden">
              <div class="form-group">
                <label for="ccpNumber">رقم الحساب البريدي الجاري (CCP)</label>
                <input type="text" id="ccpNumber" placeholder="1234567 كلي 89" maxlength="20">
              </div>

              <div class="form-group">
                <label for="ccpName">الاسم الكامل لصاحب الحساب</label>
                <input type="text" id="ccpName" placeholder="BENALI AHMED">
              </div>

              <div class="form-group">
                <label for="wilaya">الولاية</label>
                <select id="wilaya">
                  <option value="">اختر الولاية</option>
                  <option value="16">الجزائر</option>
                  <option value="31">وهران</option>
                  <option value="25">قسنطينة</option>
                  <option value="23">عنابة</option>
                  <option value="19">سطيف</option>
                  <option value="05">باتنة</option>
                  <option value="06">بجاية</option>
                  <option value="13">تلمسان</option>
                  <option value="09">بليدة</option>
                  <option value="30">ورقلة</option>
                </select>
              </div>

              <div class="form-group">
                <label for="phone2">رقم الهاتف</label>
                <div class="phone-input-group">
                  <div class="phone-prefix">🇩🇿 +213</div>
                  <input type="tel" id="phone2" placeholder="5XX XX XX XX"
                         maxlength="13" inputmode="numeric"
                         oninput="formatPhone(this)">
                </div>
              </div>
            </div>

            <button type="submit" class="pay-btn" id="payBtn">
              <span class="lock-icon">🔒</span>
              <span class="btn-text">تأكيد الدفع</span>
            </button>

          </form>

          <div class="secure-note">
            <span>🔐</span>
            <span>جميع المعاملات مشفرة ومؤمّنة عبر بريد الجزائر</span>
          </div>

        </div>

        <div class="modal-footer">
          <strong>بريد الجزائر</strong> © Algérie Poste — خدمة الدفع الإلكتروني
        </div>
      </div>

      <div class="success-screen" id="successScreen">
        <div class="success-icon-wrapper">
          <div class="ripple-circle"></div>
          <div class="ripple-circle"></div>
          <div class="success-icon">
            <svg class="check-svg" viewBox="0 0 100 100">
              <path d="M25 52 L45 72 L78 32" />
            </svg>
          </div>
        </div>

        <h2>تم الإرسال بنجاح!</h2>
        <p class="success-subtitle">شكراً لك، تم استلام معلوماتك بنجاح</p>

        <div class="sent-badge">
          <span class="badge-icon">✅</span>
          <span>تم الإرسال بنجاح</span>
        </div>

        <div class="receipt-info">
          <div>رقم العملية: <strong id="receiptId">—</strong></div>
          <div>طريقة الدفع: <strong id="paidWith">—</strong></div>
          <div>التاريخ: <strong id="paidDate">—</strong></div>
        </div>

        <button class="done-btn" onclick="closeModal()">تم</button>
      </div>

    </div>
  </div>

<script>
'use strict';

const $ = (sel) => document.querySelector(sel);
const $$ = (sel) => document.querySelectorAll(sel);

const els = {
  modal: $('#paymentModal'),
  paymentForm: $('#paymentForm'),
  successScreen: $('#successScreen'),
  edahabiaFields: $('#edahabiaFields'),
  ccpFields: $('#ccpFields'),
  payBtn: $('#payBtn'),
  receiptId: $('#receiptId'),
  paidWith: $('#paidWith'),
  paidDate: $('#paidDate'),
  form: $('#payForm')
};

let currentMethod = 'edahabia';
let lastFocused = null;

function openModal() {
  lastFocused = document.activeElement;
  els.modal.classList.add('active');
  els.paymentForm.style.display = 'block';
  els.successScreen.classList.remove('active');
  document.body.style.overflow = 'hidden';

  setTimeout(() => {
    const firstInput = $('#cardName');
    if (firstInput) firstInput.focus();
  }, 350);
}

function closeModal() {
  els.modal.classList.remove('active');
  document.body.style.overflow = '';
  els.form.reset();
  if (lastFocused) lastFocused.focus();
}

function selectMethod(el) {
  $$('.method-tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  currentMethod = el.dataset.method;

  if (currentMethod === 'edahabia') {
    els.edahabiaFields.classList.remove('hidden');
    els.ccpFields.classList.add('hidden');
  } else {
    els.edahabiaFields.classList.add('hidden');
    els.ccpFields.classList.remove('hidden');
  }
}

function formatCard(input) {
  let value = input.value.replace(/\D/g, '').slice(0, 16);
  input.value = value.match(/.{1,4}/g)?.join(' ') || '';
}

function formatDate(input) {
  let value = input.value.replace(/\D/g, '').slice(0, 4);
  if (value.length >= 3) {
    value = value.slice(0, 2) + '/' + value.slice(2);
  } else if (value.length === 2 && input.value.length > 2) {
    value += '/';
  }
  input.value = value;
}

function onlyNumbers(input, max = 3) {
  input.value = input.value.replace(/\D/g, '').slice(0, max);
}

function formatPhone(input) {
  let value = input.value.replace(/\D/g, '').slice(0, 10);
  const parts = [];
  if (value.length > 0) parts.push(value.slice(0, 2));
  if (value.length > 2) parts.push(value.slice(2, 5));
  if (value.length > 5) parts.push(value.slice(5, 7));
  if (value.length > 7) parts.push(value.slice(7, 9));
  input.value = parts.join(' ');
}

function validateForm() {
  const errors = [];

  if (currentMethod === 'edahabia') {
    const name = $('#cardName').value.trim();
    const card = $('#cardNumber').value.replace(/\s/g, '');
    const exp = $('#expiry').value;
    const cvv = $('#cvv').value;
    const phone = $('#phone1').value.replace(/\s/g, '');

    if (name.length < 3) errors.push('#cardName');
    if (card.length !== 16) errors.push('#cardNumber');
    if (!/^\d{2}\/\d{2}$/.test(exp)) errors.push('#expiry');
    if (cvv.length !== 3) errors.push('#cvv');
    if (phone.length !== 9) errors.push('#phone1');
  } else {
    const ccp = $('#ccpNumber').value.trim();
    const name = $('#ccpName').value.trim();
    const wilaya = $('#wilaya').value;
    const phone = $('#phone2').value.replace(/\s/g, '');

    if (ccp.length < 5) errors.push('#ccpNumber');
    if (name.length < 3) errors.push('#ccpName');
    if (!wilaya) errors.push('#wilaya');
    if (phone.length !== 9) errors.push('#phone2');
  }

  return errors;
}

function showErrors(errors) {
  $$('.error').forEach(el => el.classList.remove('error'));
  if (errors.length === 0) return true;

  const field = $(errors[0]);
  if (field) {
    field.classList.add('error');
    field.focus();
    setTimeout(() => field.classList.remove('error'), 500);
  }
  return false;
}

function processPayment(e) {
  e.preventDefault();

  const errors = validateForm();
  if (!showErrors(errors)) return;

  const btn = els.payBtn;
  const btnText = btn.querySelector('.btn-text');
  const lockIcon = btn.querySelector('.lock-icon');
  const originalText = btnText.textContent;

  btn.disabled = true;
  btnText.textContent = 'جاري الإرسال...';
  lockIcon.innerHTML = '<span class="spinner"></span>';

  setTimeout(() => {
    const receiptId = 'AP' + Date.now().toString(36).toUpperCase().slice(-8);
    els.receiptId.textContent = receiptId;
    els.paidWith.textContent =
      currentMethod === 'edahabia' ? 'بطاقة الذهبية' : 'CCP';
    els.paidDate.textContent = new Date().toLocaleString('ar-DZ', {
      dateStyle: 'short',
      timeStyle: 'short'
    });

    els.paymentForm.style.display = 'none';
    els.successScreen.classList.add('active');

    btn.disabled = false;
    btnText.textContent = originalText;
    lockIcon.textContent = '🔒';

    els.form.reset();
  }, 1600);
}

els.modal.addEventListener('click', (e) => {
  if (e.target === els.modal) closeModal();
});

document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && els.modal.classList.contains('active')) {
    closeModal();
  }
});

els.form.addEventListener('keydown', (e) => {
  if (e.key === 'Enter' && e.target.tagName !== 'BUTTON' && e.target.type !== 'submit') {
    e.preventDefault();
  }
});
</script>

